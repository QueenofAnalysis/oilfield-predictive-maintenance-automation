    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nfor (const item of items) {\n\n  const temp = Number(item.json.Temperature_C);\n  const pressure = Number(item.json.Pressure_psi);\n  const vibration = Number(item.json.Vibration_mm_s);\n  const flow = Number(item.json.Flow_Rate_bpd);\n\n  let risk = \"Normal\";\n  let reason = \"Equipment operating within normal limits.\";\n\n  if (temp >= 90) {\n    risk = \"Critical\";\n    reason = \"High temperature detected. Possible overheating.\";\n  } else if (vibration >= 5) {\n    risk = \"Critical\";\n    reason = \"High vibration detected. Possible mechanical failure.\";\n  } else if (flow <= 400) {\n    risk = \"Critical\";\n    reason = \"Low production flow detected.\";\n  } else if (pressure >= 3500) {\n    risk = \"Warning\";\n    reason = \"Pressure above safe operating range.\";\n  }\n\n  item.json.Risk_Level = risk;\n  item.json.Failure_Reason = reason;\n}\n\nreturn items;"
      },
